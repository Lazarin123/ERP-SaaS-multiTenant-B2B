# ============================================
# BANCO DE DADOS (Supabase / PostgreSQL)
# Pegue essa string em: Supabase > Project Settings > Database > Connection string (URI)
# Use a porta 6543 (pooler) para "DATABASE_URL" e a 5432 (direct) para "DIRECT_URL"
# ============================================
DATABASE_URL="postgresql://postgres:SENHA@db.SEUPROJETO.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:SENHA@db.SEUPROJETO.supabase.co:5432/postgres"

# ============================================
# SEGURANÇA
# ============================================
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
JWT_EXPIRES_IN="7d"

# ============================================
# SERVIDOR
# ============================================
PORT=4000
FRONTEND_URL="http://localhost:5173"

# ============================================
# IA (Anthropic Claude) - para o Chat de Suporte e IA de Marketing
# Crie sua chave em https://console.anthropic.com/
# ============================================
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-sonnet-5"

# ============================================
# UPLOADS (fotos de perfil)
# ============================================
UPLOAD_DIR="uploads"
